{
  "name": "lexsan-portal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "node scripts/build.cjs --local && node scripts/serve.cjs",
    "test": "node --test tests/domain.test.cjs",
    "test:e2e": "node tests/flow.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lexsan \"node --test tests/rules.test.cjs\"",
    "test:regression": "node tests/regression.cjs"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
